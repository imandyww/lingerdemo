# Local defaults are credential-free. Provider model names below are examples
# and MUST be verified for the installed provider/server release and hardware.
NODE_ENV=development

VOICE_PROVIDER=mock
LLM_PROVIDER=mock
DEMO_MODE=true
MOCK_AUTH=true

INWORLD_API_KEY=
INWORLD_API_SECRET=
INWORLD_STT_MODEL=
INWORLD_TTS_MODEL=inworld-tts-2
INWORLD_VOICE_ID=
INWORLD_LANGUAGE=en-US
INWORLD_TTS_DELIVERY_MODE=BALANCED
INWORLD_TTS_SAMPLE_RATE_HZ=24000

TENSTORRENT_BASE_URL=http://localhost:8000/v1
TENSTORRENT_API_KEY=
TENSTORRENT_MODEL=Llama-3.1-8B-Instruct
TENSTORRENT_HEALTH_URL=
# Example only; set to the verified served model/context limit.
TENSTORRENT_MAX_CONTEXT_TOKENS=8192

OPENAI_API_KEY=

DATABASE_URL=sqlite+aiosqlite:///./data/linger.db

APP_HOST=0.0.0.0
APP_PORT=8080
WEB_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws/voice
# Browser transport: mock is fully local; backend connects to FastAPI.
NEXT_PUBLIC_VOICE_PROVIDER=mock
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

RAW_AUDIO_RETENTION=false
# Applies only after explicit archive-save consent; never to WebSocket session logs.
TRANSCRIPT_RETENTION=true
MAX_ACTIVE_SESSIONS=20
MAX_AUDIO_FRAME_BYTES=65536
MAX_MESSAGES_PER_SECOND=80
SPECULATIVE_GENERATION=false
